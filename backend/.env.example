# Mission Operations Copilot Configuration

# Application
APP_NAME="Mission Operations Copilot Backend"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","*"]

# Database (PostgreSQL where practical, fallback to SQLite for local development)
DATABASE_URL=sqlite:///./mission_ops.db

# Vector DB
VECTOR_DB_PATH=./data/vector_store
CHROMA_COLLECTION_NAME=mission_knowledge_base

# AI / LLM Configuration
# Choose primary provider: 'ollama' (Local Open Source) or 'gemini' (Google Cloud)
# Also supports: 'openai', 'anthropic', or 'mock'
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2
LLM_FALLBACK_TO_MOCK=True

# --- Ollama (Local LLM - No API Key Needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Recommended Ollama models: llama3, mistral, deepseek-r1:8b, phi4

# --- Google Gemini Configuration ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# Spacecraft & Simulation Guardrails
SIMULATION_MODE=True
SPACECRAFT_ID=SC-01
ALLOW_HARDWARE_COMMANDS=False
